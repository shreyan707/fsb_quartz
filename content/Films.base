filters:
  and:
    - file.inFolder("movies")
    - file.ext == "md"
    - file.name != "index"
properties:
  note.release_year:
    displayName: Year
  note.director:
    displayName: Director
  note.country:
    displayName: Country
  note.screenings:
    displayName: Screened on
  note.member_screenings:
    displayName: Member screening
views:
  - type: cards
    name: Posters
    image: note.poster
    imageFit: cover
    imageAspectRatio: 0.667
    cardSize: 180
    order:
      - file.name
      - note.release_year
      - note.director
    sort:
      - property: note.release_year
        direction: ASC
  - type: table
    name: All films
    order:
      - file.name
      - note.release_year
      - note.director
      - note.country
    sort:
      - property: note.release_year
        direction: ASC
  - type: table
    name: Actor Studio
    filters:
      and:
        - file.hasTag("actor_studio")
    order:
      - file.name
      - note.release_year
      - note.director
      - note.screenings
    sort:
      - property: note.release_year
        direction: ASC
  - type: table
    name: Member Screenings
    filters:
      and:
        - file.hasTag("member_screening")
    order:
      - file.name
      - note.release_year
      - note.director
      - note.member_screenings
    sort:
      - property: note.release_year
        direction: ASC
