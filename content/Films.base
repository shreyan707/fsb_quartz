filters:
  and:
    - file.inFolder("movies")
    - file.ext == "md"
    - file.name != "index"
properties:
  note.release_year:
    displayName: Year
  note.director:
    displayName: Director
  note.country:
    displayName: Country
  note.screenings:
    displayName: Screened on
  note.member_screenings:
    displayName: Member screening
views:
  - type: cards
    name: Posters
    order:
      - file.name
      - release_year
      - director
    sort:
      - property: release_year
        direction: ASC
    image: note.poster
    imageFit: cover
    imageAspectRatio: 0.667
    cardSize: 180
  - type: table
    name: All films
    order:
      - file.name
      - release_year
      - director
      - country
    sort:
      - property: release_year
        direction: ASC
  - type: table
    name: Actor Studio
    filters:
      and:
        - file.hasTag("actor_studio")
    order:
      - file.name
      - release_year
      - director
      - screenings
    sort:
      - property: release_year
        direction: ASC
  - type: table
    name: Member Screenings
    filters:
      and:
        - file.hasTag("member_screening")
    order:
      - file.name
      - release_year
      - director
      - member_screenings
    sort:
      - property: release_year
        direction: ASC
