filters:
  and:
    - file.inFolder("Director Profiles")
    - file.ext == "md"
    - file.name != "index"
properties:
  note.films_screened:
    displayName: Films screened
views:
  - type: cards
    name: Portraits
    order:
      - file.name
      - films_screened
    sort:
      - property: file.name
        direction: ASC
    image: note.photo
    imageFit: cover
    imageAspectRatio: 0.667
    cardSize: 180
  - type: table
    name: All directors
    order:
      - file.name
      - films_screened
    sort:
      - property: file.name
        direction: ASC
