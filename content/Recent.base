filters:
  and:
    - file.inFolder("movies")
    - file.ext == "md"
    - file.name != "index"
    - formula.last_screened
formulas:
  last_screened: "[note.screenings, note.member_screenings].flat().filter(value && date(value) <= today()).sort().reverse()[0]"
properties:
  note.release_year:
    displayName: Year
  note.director:
    displayName: Director
views:
  - type: cards
    name: Recently screened
    order:
      - file.name
      - release_year
      - director
    sort:
      - property: formula.last_screened
        direction: DESC
    limit: 12
    image: note.poster
    imageFit: cover
    imageAspectRatio: 0.667
    cardSize: 180
